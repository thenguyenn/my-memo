# Supabase Configuration (Backend API)
# Lấy từ Supabase Project Settings > API
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google OAuth Configuration (Đăng nhập bằng Google)
# Lấy OAuth 2.0 Client ID (Web application) từ Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Danh sách email được phép đăng nhập (tùy chọn, ngăn cách bằng dấu phẩy; để trống = mọi tài khoản Google hợp lệ)
ALLOWED_EMAILS=

# Thời hạn Token (tính bằng giây): Access Token = 1 ngày (86400s), Refresh Token = 1 tuần (604800s)
ACCESS_TOKEN_TTL=86400
REFRESH_TOKEN_TTL=604800

# JWT Secrets dùng ký Access Token (1 ngày, chỉ lưu trong RAM) và Refresh Token (1 tuần, lưu trong HttpOnly Cookie)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_string
